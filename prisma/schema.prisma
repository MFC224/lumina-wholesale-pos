generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  VENDEDOR
}

enum TipoMovimiento {
  VENTA
  INGRESO
  AJUSTE
  ANULACION
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TARJETA
  TRANSFERENCIA
}

enum TipoDescuento {
  NINGUNO
  PORCENTAJE
  MONTO_FIJO
}

enum EstadoSesionCaja {
  ABIERTA
  CERRADA
}

model Usuario {
  id              String         @id @default(cuid())
  nombre          String
  pin             String         // Hash bcrypt del PIN de 4 dígitos
  rol             Rol            @default(VENDEDOR)
  activo          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  ventas          Venta[]        @relation("VentasUsuario")
  ventasAnuladas  Venta[]        @relation("VentasAnuladasPor")
  movimientos     MovimientoKardex[]
  sesionesCaja    SesionCaja[]   @relation("SesionesUsuario")
  sesionesFirmadas SesionCaja[]  @relation("SesionesFirmadasPorAdmin")
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String     @unique
  descripcion String?
  productos   Producto[]
}

model Producto {
  id                String          @id @default(cuid())
  nombre            String
  descripcion       String?
  codigoSku         String?         @unique
  categoriaId       String?
  categoria         Categoria?      @relation(fields: [categoriaId], references: [id])
  precioOriginal    Decimal         @db.Decimal(10, 2)
  precioLiquidacion Decimal         @db.Decimal(10, 2) // Precio de venta en liquidación (S/.)
  costo             Decimal         @db.Decimal(10, 2) // CONFIDENCIAL: Solo visible para ADMIN
  imagenUrl         String?
  activo            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  variantes         VarianteStock[]
}

model VarianteStock {
  id                String            @id @default(cuid())
  productoId        String
  producto          Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sku               String            @unique
  talla             String?
  color             String?
  ubicacion         String?           // Estante / Sección de almacén
  stockInicial      Int               @default(0)
  stockActual       Int               @default(0)
  stockMinimoAlerta Int               @default(3)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  detallesVenta     DetalleVenta[]
  movimientosKardex MovimientoKardex[]

  @@index([productoId])
  @@index([sku])
}

model MovimientoKardex {
  id            String          @id @default(cuid())
  varianteId    String
  variante      VarianteStock   @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  tipo          TipoMovimiento
  cantidad      Int             // Positivo para ingreso/anulación, negativo para venta
  stockAnterior Int
  stockNuevo    Int
  motivo        String?
  usuarioId     String
  usuario       Usuario         @relation(fields: [usuarioId], references: [id])
  ventaId       String?
  venta         Venta?          @relation(fields: [ventaId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([varianteId])
  @@index([usuarioId])
  @@index([ventaId])
}

model Venta {
  id              String            @id @default(cuid())
  numeroTicket    String            @unique
  usuarioId       String
  usuario         Usuario           @relation("VentasUsuario", fields: [usuarioId], references: [id])
  subtotal        Decimal           @db.Decimal(10, 2)
  descuento       Decimal           @default(0) @db.Decimal(10, 2)
  tipoDescuento   TipoDescuento     @default(NINGUNO)
  total           Decimal           @db.Decimal(10, 2)
  metodoPago      MetodoPago        @default(EFECTIVO)
  montoRecibido   Decimal?          @db.Decimal(10, 2)
  vuelto          Decimal?          @default(0) @db.Decimal(10, 2)
  estado          EstadoVenta       @default(COMPLETADA)
  anuladoPorId    String?
  anuladoPor      Usuario?          @relation("VentasAnuladasPor", fields: [anuladoPorId], references: [id])
  motivoAnulacion String?
  sesionCajaId    String?
  sesionCaja      SesionCaja?       @relation(fields: [sesionCajaId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  detalles        DetalleVenta[]
  movimientos     MovimientoKardex[]

  @@index([usuarioId])
  @@index([numeroTicket])
  @@index([sesionCajaId])
}

model DetalleVenta {
  id             String        @id @default(cuid())
  ventaId        String
  venta          Venta         @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  varianteId     String
  variante       VarianteStock @relation(fields: [varianteId], references: [id])
  cantidad       Int
  precioUnitario Decimal       @db.Decimal(10, 2)
  subtotal       Decimal       @db.Decimal(10, 2)

  @@index([ventaId])
  @@index([varianteId])
}

model SesionCaja {
  id                String            @id @default(cuid())
  usuarioId         String
  usuario           Usuario           @relation("SesionesUsuario", fields: [usuarioId], references: [id])
  fechaApertura     DateTime          @default(now())
  fechaCierre       DateTime?
  montoApertura     Decimal           @db.Decimal(10, 2)
  efectivoEsperado  Decimal?          @db.Decimal(10, 2)
  efectivoReal      Decimal?          @db.Decimal(10, 2)
  diferencia        Decimal?          @db.Decimal(10, 2)
  totalVentas       Decimal?          @default(0) @db.Decimal(10, 2)
  estado            EstadoSesionCaja  @default(ABIERTA)
  observaciones     String?
  firmadoPorAdminId String?
  firmadoPorAdmin   Usuario?          @relation("SesionesFirmadasPorAdmin", fields: [firmadoPorAdminId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ventas            Venta[]

  @@index([usuarioId])
  @@index([firmadoPorAdminId])
}
